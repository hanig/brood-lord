  "entries":[
    {"id":"DB001","skill":"hanig-swarm","what_broke":"Terminal dispatch without recorded id.","mechanism":"Records showed dispatch failure before any job or agent id was recorded; launch remained unknown.","proposed_change":"Preserve ambiguous dispatch evidence.","measures":[{"measure":"dispatch_without_identifier","population":"attempts"}]},
    {"id":"DB002","skill":"hanig-swarm","what_broke":"Preemption exhausted a unit.","mechanism":"Records described manual reissue after preemption exhaustion.","proposed_change":"Declare bounded recovery with lineage.","measures":[{"measure":"preemption_exhausted","population":"units"}]},
    {"id":"DB003","skill":"hanig-swarm","what_broke":"Requeue reused an attempt root.","mechanism":"Records described requeue rerunning in the same attempt root.","proposed_change":"Bind requeue execution evidence.","measures":[{"measure":"requeued_in_same_root","population":"attempts"}]},
    {"id":"DB004","skill":"hanig-swarm","what_broke":"Missing accounting became terminal evidence.","mechanism":"Records reported terminal classification after accounting remained unavailable past settling.","proposed_change":"Keep missing accounting nonterminal.","measures":[{"measure":"accounting_unavailable_at_terminal","population":"attempts"}]},
    {"id":"DB005","skill":"hanig-swarm","what_broke":"Advance started an unintended run.","mechanism":"Records described advance without state paths selecting another run.","proposed_change":"Require explicit run binding.","measures":[{"measure":"unintended_run_context","population":"state_entries"}]},
    {"id":"DB006","skill":"hanig-swarm","what_broke":"Supersession needed dependency edits.","mechanism":"Records showed dependencies repointed manually during supersession.","proposed_change":"Validate dependency repair.","measures":[{"measure":"manual_dependency_repoint","population":"units"}]},
    {"id":"DB007","skill":"hanig-swarm","what_broke":"Merge waiting occupied running slots.","mechanism":"Records counted merge-waiting code units against execution capacity.","proposed_change":"Separate execution and merge occupancy.","measures":[{"measure":"awaiting_merge_in_running_slots","population":"units"}]},
    {"id":"DB008","skill":"hanig-review-gate","what_broke":"Refusals consumed review rounds.","mechanism":"Records linked service or sandbox refusals to implementation round advancement.","proposed_change":"Distinguish refusal from substantive review.","measures":[{"measure":"refusal_consumed_round","population":"evidence_documents"}]},
    {"id":"DB009","skill":"hanig-review-gate","what_broke":"Review did not converge.","mechanism":"Records described unresolved or new findings across repair rounds.","proposed_change":"Expose history and bounded escalation.","measures":[{"measure":"nonconvergent_review","population":"units"}]},
    {"id":"DB010","skill":"hanig-project","what_broke":"Plan command disagreed with CLI.","mechanism":"Records paired plan commands with interface-mismatch refusals.","proposed_change":"Preflight declared command interfaces.","measures":[{"measure":"command_interface_mismatch","population":"units"}]},
    {"id":"DB011","skill":"hanig-project","what_broke":"Placement policy was duplicated.","mechanism":"Records described local placement policy outside the skill.","proposed_change":"Provide reusable placement policy.","measures":[{"measure":"placement_policy_helper","population":"helper_scripts"}]},
    {"id":"DB012","skill":"hanig-orchestrate","what_broke":"Durable helpers were duplicated.","mechanism":"Records described project-specific watcher or merge helpers.","proposed_change":"Provide durable coordination helpers.","measures":[{"measure":"durable_coordination_helper","population":"helper_scripts"}]},
    {"id":"DB013","skill":"hanig-swarm","what_broke":"Dry-run reportedly changed recovery state.","mechanism":"Records asserted this behavior without reproducing it.","proposed_change":"Test dry-run through its consumer.","measures":[{"measure":"reported_dry_run_recovery_write","population":"evidence_documents"}]},
    {"id":"DB014","skill":"hanig-review-gate","what_broke":"Fixtures wrote real state.","mechanism":"Records described review fixtures writing outside temporary state homes.","proposed_change":"Bind and test fixture state homes.","measures":[{"measure":"fixture_state_home_write","population":"evidence_documents"}]},
    {"id":"DB015","skill":"hanig-swarm","what_broke":"Validated concurrency was unenforced.","mechanism":"Records described accepted limits alongside excess execution.","proposed_change":"Test enforcement through dispatch.","measures":[{"measure":"concurrency_bound_exceeded","population":"state_entries"}]},
    {"id":"DB016","skill":"hanig-swarm","what_broke":"External removal lost a live worktree.","mechanism":"Records described external removal while the unit remained live.","proposed_change":"Detect loss and preserve attempt evidence.","measures":[{"measure":"live_worktree_removed","population":"attempts"}]}
  ]
